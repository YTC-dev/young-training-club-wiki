# Copy thành .env, rồi dán URI MỚI sau khi đã đổi mật khẩu Atlas.
MONGO_URI=mongodb+srv://<database-user>:<new-password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
PORT=3000
# Để trống trong dev cho phép local preview; khi deploy, đặt origin website, ví dụ https://quiz.example.com
CORS_ORIGINS=
